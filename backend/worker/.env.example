# EcoWatch geospatial worker (internal service; never expose publicly)

# Copernicus Data Space Ecosystem S3 credentials. Generate them after registering at
# https://dataspace.copernicus.eu (see backend/README.md). Leave empty to run without
# satellite processing: discovery still works and the API reports "configuration_required".
CDSE_S3_ACCESS_KEY_ID=
CDSE_S3_SECRET_ACCESS_KEY=

# Shared secret the Node API sends in X-Worker-Token. Must match backend/api/.env.
WORKER_TOKEN=change-me-to-a-long-random-string

# Optional overrides (defaults shown)
# CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
# CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
# WORKER_CACHE_DIR=./.cache
# WORKER_CONCURRENCY=2
# LST_MIN_VALID_AREA_PERCENT=30
# LST_MAX_RADIUS_KM=50
# LST_MAX_PRODUCTS_PER_JOB=4
# LST_MASK_TIDAL_AS_WATER=true
