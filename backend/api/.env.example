# EcoWatch API gateway (Node). Secrets here never reach the mobile app.
PORT=8787
HOST=0.0.0.0
# Set to 1 when running behind Nginx (VPS) so rate limits use the visitor's real IP.
# TRUST_PROXY=1

# Internal geospatial worker
WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=change-me-to-a-long-random-string

# OpenRouter (https://openrouter.ai/keys). Powers the in-app AI assistant (POST /api/v1/ai/chat)
# and the city AI explanation. Without a key the assistant reports "not configured" and the
# explanation falls back to deterministic text.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_TIMEOUT_MS=20000
# Requests per minute per client IP for the AI assistant, and how long a silent stream may stall.
# AI_RATE_LIMIT_PER_MINUTE=10
# OPENROUTER_STREAM_IDLE_TIMEOUT_MS=60000
# Seconds to wait for a model to start answering before failing over to the next model tier.
# OPENROUTER_FIRST_TOKEN_TIMEOUT_MS=20000

# Area and caching
# AREA_DEFAULT_RADIUS_KM=15
# AREA_MAX_RADIUS_KM=50
# WEATHER_CACHE_TTL_SECONDS=600
# WEATHER_STALE_AFTER_MINUTES=180

# Comma-separated origins allowed to call the API from a browser (Expo web)
CORS_ORIGINS=http://localhost:8081
# RATE_LIMIT_PER_MINUTE=120

# Supabase sign-up without verification emails. The API creates accounts already confirmed with
# the service key, which stays on this server. Get it from the Supabase dashboard:
# Project Settings > API Keys > service_role (legacy) or a Secret key (sb_secret_...).
SUPABASE_URL=https://jtevyqaooasufpgootyo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SIGNUP_RATE_LIMIT_PER_HOUR=20
